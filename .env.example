# Use the existing ChatGPT login from `codex login`; Astra is the default model.
PERSONA2_BACKEND=codex

# For the Anthropic API instead, set PERSONA2_BACKEND=anthropic and your key.
ANTHROPIC_API_KEY=

# For a Claude subscription instead, set PERSONA2_BACKEND=claude.
# Legacy setting, used only when PERSONA2_BACKEND is absent:
# PERSONA2_CLAUDE_CLI=1
